package __PACKAGE__

import android.app.AlarmManager
import android.appwidget.AppWidgetManager
import android.appwidget.AppWidgetProvider
import android.content.ComponentName
import android.content.Context
import android.os.Bundle
import android.view.View
import android.widget.RemoteViews

import org.json.JSONObject

import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale
import java.util.TimeZone

// Generated by plugins/withBelgranoLiveTrip.js — do not edit by hand.
//
// Home-screen widgets (phone only): 2×2 "next train" and 4×2 "next train + following ones".
// RemoteViews only; they render the shared trip snapshot (TripSnapshotStore). Localized labels
// come from the snapshot's optional "labels" object written by JS (Spanish defaults otherwise).

abstract class BelgranoTripWidgetBase : AppWidgetProvider() {
  protected abstract val wide: Boolean

  override fun onUpdate(context: Context, appWidgetManager: AppWidgetManager, appWidgetIds: IntArray) {
    TripWidgets.render(context, appWidgetManager, appWidgetIds, wide)
    TripWidgets.scheduleTick(context)
  }

  override fun onAppWidgetOptionsChanged(
      context: Context,
      appWidgetManager: AppWidgetManager,
      appWidgetId: Int,
      newOptions: Bundle
  ) {
    TripWidgets.render(context, appWidgetManager, intArrayOf(appWidgetId), wide)
  }

  override fun onEnabled(context: Context) {
    TripWidgets.scheduleTick(context)
  }

  override fun onDisabled(context: Context) {
    // Cancels the refresh tick when no widget of either size is left.
    TripWidgets.scheduleTick(context)
  }
}

class BelgranoTripWidgetSmall : BelgranoTripWidgetBase() {
  override val wide: Boolean = false
}

class BelgranoTripWidgetWide : BelgranoTripWidgetBase() {
  override val wide: Boolean = true
}

object TripWidgets {
  private const val TIME_ZONE = "America/Argentina/Buenos_Aires"
  private const val MINUTE_MS = 60L * 1000
  private const val NEAR_DEPARTURE_MS = 60L * MINUTE_MS
  private const val PAST_TOLERANCE_MS = 30L * 1000
  private const val COMPACT_MAX_HEIGHT_DP = 150

  private class Departure(val departure: Long, val arrival: Long?, val source: String)

  private class Labels(json: JSONObject?) {
    val nextTrain = json.label("nextTrain", "Próximo tren")
    val live = json.label("live", "En vivo")
    val scheduled = json.label("scheduled", "Programado")
    val offline = json.label("offline", "Sin conexión")
    val inMinutes = json.label("inMinutes", "en {n} min")
    val now = json.label("now", "ahora")
    val agoSeconds = json.label("agoSeconds", "hace {n} s")
    val agoMinutes = json.label("agoMinutes", "hace {n} min")
    val openApp = json.label("openApp", "Abrí la app para ver los próximos trenes")
    val noMoreTrains = json.label("noMoreTrains", "No hay más trenes por ahora")
    val separator = json.label("separator", " · ")

    fun source(source: String): String = when (source) {
      "live" -> live
      "offline" -> offline
      else -> scheduled
    }

    fun countdown(departure: Long, now: Long): String {
      val minutes = Math.ceil((departure - now).toDouble() / MINUTE_MS).toLong()

      return if (minutes <= 0) this.now else inMinutes.replace("{n}", minutes.toString())
    }

    fun freshness(source: String, fetchedAt: Long?, now: Long): String {
      if (source != "live" || fetchedAt == null) return source(source)

      val elapsed = maxOf(0L, now - fetchedAt)
      val ago = if (elapsed < MINUTE_MS) {
        agoSeconds.replace("{n}", (elapsed / 1000).toString())
      } else {
        agoMinutes.replace("{n}", (elapsed / MINUTE_MS).toString())
      }

      return live + separator + ago
    }

    companion object {
      private fun JSONObject?.label(key: String, fallback: String): String =
          this?.optStringOrNull(key) ?: fallback
    }
  }

  fun updateAll(context: Context) {
    val manager = AppWidgetManager.getInstance(context) ?: return

    render(context, manager, ids(context, manager, BelgranoTripWidgetSmall::class.java), false)
    render(context, manager, ids(context, manager, BelgranoTripWidgetWide::class.java), true)
    scheduleTick(context)
  }

  fun render(context: Context, manager: AppWidgetManager, appWidgetIds: IntArray, wide: Boolean) {
    if (appWidgetIds.isEmpty()) return

    val snapshot = TripSnapshotStore.readSnapshot(context)
    val now = System.currentTimeMillis()

    for (appWidgetId in appWidgetIds) {
      val minHeight = manager.getAppWidgetOptions(appWidgetId)
          ?.getInt(AppWidgetManager.OPTION_APPWIDGET_MIN_HEIGHT, 0) ?: 0
      val compact = minHeight in 1 until COMPACT_MAX_HEIGHT_DP

      manager.updateAppWidget(appWidgetId, build(context, snapshot, wide, compact, now))
    }
  }

  /**
   * Keeps "en N min" fresh with a non-wakeup, inexact alarm (fires only while the device is
   * awake): every minute within an hour of the next train, every 5 minutes otherwise. No alarm
   * when there are no widgets or no upcoming trains; a new snapshot reschedules it.
   */
  fun scheduleTick(context: Context) {
    val alarmManager = context.getSystemService(Context.ALARM_SERVICE) as? AlarmManager ?: return
    val tick = LiveTripIntents.widgetTick(context)
    val manager = AppWidgetManager.getInstance(context)
    val hasWidgets = manager != null && (
        ids(context, manager, BelgranoTripWidgetSmall::class.java).isNotEmpty() ||
            ids(context, manager, BelgranoTripWidgetWide::class.java).isNotEmpty()
        )
    val now = System.currentTimeMillis()
    val next = upcoming(TripSnapshotStore.readSnapshot(context), now).firstOrNull()

    if (!hasWidgets || next == null) {
      alarmManager.cancel(tick)
      return
    }

    val step = if (next.departure - now > NEAR_DEPARTURE_MS) 5 * MINUTE_MS else MINUTE_MS
    val triggerAt = (now / step + 1) * step + 1000

    alarmManager.set(AlarmManager.RTC, triggerAt, tick)
  }

  private fun ids(context: Context, manager: AppWidgetManager, provider: Class<*>): IntArray =
      try {
        manager.getAppWidgetIds(ComponentName(context, provider)) ?: IntArray(0)
      } catch (e: RuntimeException) {
        IntArray(0)
      }

  private fun upcoming(snapshot: JSONObject?, now: Long): List<Departure> {
    val departures = snapshot?.optJSONArray("departures") ?: return emptyList()
    val result = ArrayList<Departure>()

    for (index in 0 until departures.length()) {
      val item = departures.optJSONObject(index) ?: continue
      val departure = item.optLongOrNull("departure") ?: continue

      if (departure < now - PAST_TOLERANCE_MS) continue

      result.add(Departure(departure, item.optLongOrNull("arrival"), item.optStringOrNull("source") ?: "scheduled"))
    }

    return result.sortedBy { it.departure }
  }

  private fun build(
      context: Context,
      snapshot: JSONObject?,
      wide: Boolean,
      compact: Boolean,
      now: Long
  ): RemoteViews {
    val layout = if (wide) R.layout.belgrano_trip_widget_wide else R.layout.belgrano_trip_widget_small
    val views = RemoteViews(context.packageName, layout)
    val labels = Labels(snapshot?.optJSONObject("labels"))
    val departures = upcoming(snapshot, now)

    views.setOnClickPendingIntent(
        R.id.belgrano_widget_root,
        LiveTripIntents.launchApp(context, LiveTripIntents.REQUEST_WIDGET_OPEN)
    )
    views.setTextViewText(R.id.belgrano_widget_header, labels.nextTrain)
    views.setTextViewText(R.id.belgrano_widget_route, snapshot?.let { routeTitle(it) } ?: "")
    views.setViewVisibility(R.id.belgrano_widget_route, if (snapshot == null) View.GONE else View.VISIBLE)

    val first = departures.firstOrNull()

    if (first == null) {
      views.setViewVisibility(R.id.belgrano_widget_content, View.GONE)
      views.setViewVisibility(R.id.belgrano_widget_empty, View.VISIBLE)
      views.setTextViewText(
          R.id.belgrano_widget_empty,
          if (snapshot == null) labels.openApp else labels.noMoreTrains
      )
      return views
    }

    views.setViewVisibility(R.id.belgrano_widget_content, View.VISIBLE)
    views.setViewVisibility(R.id.belgrano_widget_empty, View.GONE)
    views.setTextViewText(R.id.belgrano_widget_time, formatTime(first.departure))
    views.setTextViewText(R.id.belgrano_widget_countdown, labels.countdown(first.departure, now))

    val freshness = labels.freshness(first.source, snapshot?.optLongOrNull("fetchedAt"), now)
    val isLive = first.source == "live"

    views.setTextViewText(R.id.belgrano_widget_freshness_live, freshness)
    views.setTextViewText(R.id.belgrano_widget_freshness_other, freshness)
    views.setViewVisibility(R.id.belgrano_widget_freshness_live, if (isLive) View.VISIBLE else View.GONE)
    views.setViewVisibility(R.id.belgrano_widget_freshness_other, if (isLive) View.GONE else View.VISIBLE)

    if (wide) {
      bindRow(views, R.id.belgrano_widget_row1, R.id.belgrano_widget_row1_time, R.id.belgrano_widget_row1_source,
          R.id.belgrano_widget_row1_minutes, departures.getOrNull(1), labels, now)
      bindRow(views, R.id.belgrano_widget_row2, R.id.belgrano_widget_row2_time, R.id.belgrano_widget_row2_source,
          R.id.belgrano_widget_row2_minutes, if (compact) null else departures.getOrNull(2), labels, now)
      views.setViewVisibility(
          R.id.belgrano_widget_divider,
          if (departures.size > 1) View.VISIBLE else View.GONE
      )
    } else {
      views.setViewVisibility(R.id.belgrano_widget_freshness, if (compact) View.GONE else View.VISIBLE)
    }

    return views
  }

  private fun bindRow(
      views: RemoteViews,
      rowId: Int,
      timeId: Int,
      sourceId: Int,
      minutesId: Int,
      departure: Departure?,
      labels: Labels,
      now: Long
  ) {
    if (departure == null) {
      views.setViewVisibility(rowId, View.GONE)
      return
    }

    views.setViewVisibility(rowId, View.VISIBLE)
    views.setTextViewText(timeId, formatTime(departure.departure))
    views.setTextViewText(sourceId, labels.source(departure.source))
    views.setTextViewText(minutesId, labels.countdown(departure.departure, now))
  }

  private fun routeTitle(snapshot: JSONObject): String {
    val origin = snapshot.optJSONObject("origin")?.optStringOrNull("title") ?: ""
    val destination = snapshot.optJSONObject("destination")?.optStringOrNull("title") ?: ""

    return if (origin.isEmpty() && destination.isEmpty()) "" else "$origin → $destination"
  }

  private fun formatTime(epochMs: Long): String {
    val format = SimpleDateFormat("HH:mm", Locale.ROOT)
    format.timeZone = TimeZone.getTimeZone(TIME_ZONE)

    return format.format(Date(epochMs))
  }
}
