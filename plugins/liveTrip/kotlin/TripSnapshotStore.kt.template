package __PACKAGE__

import android.content.Context
import android.content.Intent
import android.content.SharedPreferences

import org.json.JSONObject

// Generated by plugins/withBelgranoLiveTrip.js — do not edit by hand.
//
// Shared trip snapshot (contract: plugins/README-native.md). JS writes it through
// BelgranoLiveTrip.publishSnapshot(json); widgets, Wear tile/complications and the ongoing
// notification read it. The "tracking" block is always owned by native: it mirrors the trip
// stored under KEY_TRACKING so a stale JS copy can never resurrect a stopped trip.
object TripSnapshotStore {
  const val PREFS_NAME = "belgrano_trip_snapshot"
  const val KEY_JSON = "json"
  const val KEY_TRACKING = "tracking_json"

  /** Broadcast action suffix; full action is "<applicationId>.TRIP_SNAPSHOT_UPDATED". */
  const val ACTION_SUFFIX = ".TRIP_SNAPSHOT_UPDATED"
  const val EXTRA_TRACKING_ACTIVE = "trackingActive"

  /** Trips without an arrival time are considered over this long after departure. */
  const val DEFAULT_TRIP_MS = 2L * 60 * 60 * 1000
  /** Tracking is kept for a while after arrival before it expires on its own. */
  const val TRACKING_GRACE_MS = 10L * 60 * 1000

  fun updatedAction(context: Context): String = context.packageName + ACTION_SUFFIX

  private fun prefs(context: Context): SharedPreferences =
      context.applicationContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)

  fun readSnapshot(context: Context): JSONObject? = parseObject(prefs(context).getString(KEY_JSON, null))

  /** The tracked trip payload (as sent by JS to startTracking), or null once stopped/expired. */
  fun readTracking(context: Context): JSONObject? {
    val tracking = parseObject(prefs(context).getString(KEY_TRACKING, null)) ?: return null

    if (isExpired(tracking, System.currentTimeMillis())) {
      writeTracking(context, null)
      LiveTripNotifier.cancel(context)
      return null
    }

    return tracking
  }

  @Synchronized
  fun writeSnapshot(context: Context, json: String): Boolean {
    val snapshot = JSONObject(json)
    val tracking = parseObject(prefs(context).getString(KEY_TRACKING, null))
        ?.takeUnless { isExpired(it, System.currentTimeMillis()) }

    applyTracking(snapshot, tracking)

    return prefs(context).edit().putString(KEY_JSON, snapshot.toString()).commit()
  }

  @Synchronized
  fun clearSnapshot(context: Context): Boolean = prefs(context).edit().remove(KEY_JSON).commit()

  @Synchronized
  fun writeTracking(context: Context, tracking: JSONObject?): Boolean {
    val editor = prefs(context).edit()

    if (tracking == null) {
      editor.remove(KEY_TRACKING)
    } else {
      editor.putString(KEY_TRACKING, tracking.toString())
    }

    readSnapshot(context)?.let { snapshot ->
      applyTracking(snapshot, tracking)
      editor.putString(KEY_JSON, snapshot.toString())
    }

    return editor.commit()
  }

  fun isExpired(tracking: JSONObject, now: Long): Boolean {
    val trip = tracking.optJSONObject("trip") ?: return true
    val departure = trip.optLongOrNull("departure") ?: return true
    val end = trip.optLongOrNull("arrival") ?: (departure + DEFAULT_TRIP_MS)

    return now > end + TRACKING_GRACE_MS
  }

  /** Refreshes every surface that renders the snapshot and tells other components (Wear tile/complication). */
  fun notifyChanged(context: Context) {
    val trackingActive = parseObject(prefs(context).getString(KEY_TRACKING, null)) != null

    try {
      TripWidgets.updateAll(context)
    } catch (e: RuntimeException) {
      // Widgets are best effort (e.g. no AppWidget host on Wear OS).
    }

    context.sendBroadcast(
        Intent(updatedAction(context))
            .setPackage(context.packageName)
            .putExtra(EXTRA_TRACKING_ACTIVE, trackingActive)
    )

    LiveTripEvents.emit(trackingActive)
  }

  private fun applyTracking(snapshot: JSONObject, tracking: JSONObject?) {
    val trip = tracking?.optJSONObject("trip")
    val block = JSONObject()

    block.put("active", trip != null)
    block.put("nextStation", trip?.optStringOrNull("nextStation") ?: JSONObject.NULL)
    block.put("arrivalAt", trip?.optLongOrNull("arrival") ?: JSONObject.NULL)

    snapshot.put("tracking", block)
  }

  private fun parseObject(json: String?): JSONObject? {
    if (json.isNullOrEmpty()) return null

    return try {
      JSONObject(json)
    } catch (e: Exception) {
      null
    }
  }
}

internal fun JSONObject.optLongOrNull(key: String): Long? {
  if (!has(key) || isNull(key)) return null

  return when (val value = opt(key)) {
    is Number -> value.toLong()
    is String -> value.toDoubleOrNull()?.toLong()
    else -> null
  }
}

internal fun JSONObject.optStringOrNull(key: String): String? {
  if (!has(key) || isNull(key)) return null

  return optString(key).takeIf { it.isNotEmpty() }
}
