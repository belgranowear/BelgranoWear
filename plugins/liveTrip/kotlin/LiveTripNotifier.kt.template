package __PACKAGE__

import android.Manifest
import android.app.Notification
import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.PendingIntent
import android.content.Context
import android.content.pm.PackageManager
import android.graphics.drawable.Icon
import android.os.Build
import android.os.Bundle

import androidx.annotation.RequiresApi
import androidx.core.app.NotificationCompat
import androidx.core.app.NotificationManagerCompat
import androidx.core.content.ContextCompat

import org.json.JSONObject

// Generated by plugins/withBelgranoLiveTrip.js — do not edit by hand.
//
// Ongoing "Seguir viaje" notification. Every visible string comes from JS (already localized):
//
//   { "trip": { origin, destination, departure, arrival, source, nextStation },
//     "title": "Boulogne Sur Mer → Retiro", "text": "Sale 07:40 · en 6 min · Llega 08:18",
//     "subText": "En vivo", "shortText": "6 min",
//     "labels": { "stop": "Dejar de seguir", "open": "Abrir",
//                 "channelName": "Seguimiento de viaje", "channelDescription": "…" } }
//
// API 36+ (Android 16): Notification.ProgressStyle + promoted-ongoing request (Live Update with a
// status bar chip). Older releases, or if anything in that path fails: NotificationCompat ongoing
// notification with a countdown chronometer and a progress bar. No foreground service: JS updates
// the notification and it times out on its own shortly after the arrival time.
object LiveTripNotifier {
  const val CHANNEL_ID = "belgrano-live-trip"
  const val NOTIFICATION_ID = 41801

  private const val PROGRESS_MAX = 1000
  private const val ACCENT_COLOR = 0xFFBE4936.toInt()
  private const val MIN_TIMEOUT_MS = 60L * 1000

  // Notification.EXTRA_REQUEST_PROMOTED_ONGOING (API 36), spelled out to stay source compatible.
  private const val EXTRA_REQUEST_PROMOTED_ONGOING = "android.requestPromotedOngoing"

  // Simple name of the Wear-only Ongoing Activity helper (agent K, withBelgranoWear.js).
  private const val WEAR_ONGOING_CLASS = "BelgranoWearOngoing"

  private class Content(
      val title: String,
      val text: String,
      val subText: String?,
      val shortText: String?,
      val stopLabel: String,
      val openLabel: String,
      val chronometerTarget: Long,
      val progress: Int?,
      val timeoutMs: Long,
      val openIntent: PendingIntent,
      val stopIntent: PendingIntent,
  )

  /** Posts or replaces the notification. Returns false when notifications can't be shown. */
  fun show(context: Context, payload: JSONObject): Boolean {
    val trip = payload.optJSONObject("trip") ?: return false
    val departure = trip.optLongOrNull("departure") ?: return false

    if (!canPost(context)) return false

    val labels = payload.optJSONObject("labels") ?: JSONObject()

    ensureChannel(context, labels)

    if (isChannelBlocked(context)) return false

    val now = System.currentTimeMillis()
    val arrival = trip.optLongOrNull("arrival")
    val end = arrival ?: (departure + TripSnapshotStore.DEFAULT_TRIP_MS)

    val content = Content(
        title = payload.optStringOrNull("title") ?: routeTitle(trip),
        text = payload.optStringOrNull("text") ?: "",
        subText = payload.optStringOrNull("subText"),
        shortText = payload.optStringOrNull("shortText"),
        stopLabel = labels.optStringOrNull("stop") ?: "Dejar de seguir",
        openLabel = labels.optStringOrNull("open") ?: "Abrir",
        chronometerTarget = if (now < departure || arrival == null) departure else arrival,
        progress = progressFor(now, departure, arrival),
        timeoutMs = maxOf(MIN_TIMEOUT_MS, end + TripSnapshotStore.TRACKING_GRACE_MS - now),
        openIntent = LiveTripIntents.launchApp(context, LiveTripIntents.REQUEST_NOTIFICATION_OPEN),
        stopIntent = LiveTripIntents.stopTracking(context),
    )

    val wearOngoing = findWearOngoing(context)

    val notification = if (wearOngoing == null && Build.VERSION.SDK_INT >= 36) {
      try {
        buildLiveUpdate(context, content)
      } catch (t: Throwable) {
        compatBuilder(context, content).build()
      }
    } else {
      val builder = compatBuilder(context, content)

      if (wearOngoing != null) applyWearOngoing(context, wearOngoing, builder)

      builder.build()
    }

    return try {
      notificationManager(context).notify(NOTIFICATION_ID, notification)
      true
    } catch (e: SecurityException) {
      false
    } catch (e: RuntimeException) {
      false
    }
  }

  fun cancel(context: Context) {
    try {
      notificationManager(context).cancel(NOTIFICATION_ID)
    } catch (e: RuntimeException) {
      // Nothing to cancel.
    }
  }

  private fun notificationManager(context: Context): NotificationManager =
      context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager

  private fun canPost(context: Context): Boolean {
    if (Build.VERSION.SDK_INT >= 33 &&
        ContextCompat.checkSelfPermission(context, Manifest.permission.POST_NOTIFICATIONS) !=
            PackageManager.PERMISSION_GRANTED) {
      return false
    }

    return NotificationManagerCompat.from(context).areNotificationsEnabled()
  }

  private fun ensureChannel(context: Context, labels: JSONObject) {
    if (Build.VERSION.SDK_INT < 26) return

    val channel = NotificationChannel(
        CHANNEL_ID,
        labels.optStringOrNull("channelName") ?: "Seguimiento de viaje",
        NotificationManager.IMPORTANCE_DEFAULT
    )

    channel.description = labels.optStringOrNull("channelDescription")
    channel.setSound(null, null)
    channel.enableVibration(false)
    channel.setShowBadge(false)
    channel.lockscreenVisibility = Notification.VISIBILITY_PUBLIC

    // Creating an existing channel only updates its name/description; user choices are kept.
    notificationManager(context).createNotificationChannel(channel)
  }

  private fun isChannelBlocked(context: Context): Boolean {
    if (Build.VERSION.SDK_INT < 26) return false

    val channel = notificationManager(context).getNotificationChannel(CHANNEL_ID) ?: return false

    return channel.importance == NotificationManager.IMPORTANCE_NONE
  }

  private fun routeTitle(trip: JSONObject): String {
    val origin = trip.optJSONObject("origin")?.optStringOrNull("title") ?: ""
    val destination = trip.optJSONObject("destination")?.optStringOrNull("title") ?: ""

    return "$origin → $destination"
  }

  /** 0 before departure, linear between departure and arrival, null when arrival is unknown. */
  private fun progressFor(now: Long, departure: Long, arrival: Long?): Int? {
    if (arrival == null || arrival <= departure) return null
    if (now <= departure) return 0
    if (now >= arrival) return PROGRESS_MAX

    return (((now - departure).toDouble() / (arrival - departure)) * PROGRESS_MAX).toInt()
  }

  /**
   * Wear OS builds (plugins/withBelgranoWear.js) ship `object BelgranoWearOngoing` with
   * `apply(context: Context, notificationId: Int, builder: NotificationCompat.Builder, snapshotJson: String?)`,
   * which turns the notification into an Ongoing Activity. Phone builds don't have the class.
   */
  private fun findWearOngoing(context: Context): Class<*>? =
      try {
        Class.forName("${context.packageName}.$WEAR_ONGOING_CLASS")
      } catch (t: Throwable) {
        null
      }

  private fun applyWearOngoing(context: Context, wearOngoing: Class<*>, builder: NotificationCompat.Builder) {
    try {
      val instance = wearOngoing.getField("INSTANCE").get(null)
      val apply = wearOngoing.getMethod(
          "apply",
          Context::class.java,
          Integer.TYPE,
          NotificationCompat.Builder::class.java,
          String::class.java
      )

      apply.invoke(instance, context, NOTIFICATION_ID, builder, TripSnapshotStore.readSnapshot(context)?.toString())
    } catch (t: Throwable) {
      // Signature mismatch or Ongoing Activity unavailable: plain ongoing notification.
    }
  }

  private fun compatBuilder(context: Context, content: Content): NotificationCompat.Builder {
    val builder = NotificationCompat.Builder(context, CHANNEL_ID)
        .setSmallIcon(R.drawable.belgrano_ic_train)
        .setColor(ACCENT_COLOR)
        .setContentTitle(content.title)
        .setContentText(content.text)
        .setSubText(content.subText)
        .setOngoing(true)
        .setOnlyAlertOnce(true)
        .setSilent(true)
        .setCategory(NotificationCompat.CATEGORY_PROGRESS)
        .setPriority(NotificationCompat.PRIORITY_DEFAULT)
        .setVisibility(NotificationCompat.VISIBILITY_PUBLIC)
        .setShowWhen(true)
        .setWhen(content.chronometerTarget)
        .setUsesChronometer(true)
        .setChronometerCountDown(true)
        .setTimeoutAfter(content.timeoutMs)
        .setContentIntent(content.openIntent)
        .addAction(R.drawable.belgrano_ic_stop, content.stopLabel, content.stopIntent)
        .addAction(R.drawable.belgrano_ic_open, content.openLabel, content.openIntent)

    if (content.progress != null) {
      builder.setProgress(PROGRESS_MAX, content.progress, false)
    }

    return builder
  }

  @RequiresApi(36)
  private fun buildLiveUpdate(context: Context, content: Content): Notification {
    val style = Notification.ProgressStyle()
        .setStyledByProgress(false)
        .setProgressTrackerIcon(Icon.createWithResource(context, R.drawable.belgrano_ic_train))
        .setProgressSegments(
            listOf(Notification.ProgressStyle.Segment(PROGRESS_MAX).setColor(ACCENT_COLOR))
        )
        .setProgress(content.progress ?: 0)

    val builder = Notification.Builder(context, CHANNEL_ID)
        .setSmallIcon(R.drawable.belgrano_ic_train)
        .setColor(ACCENT_COLOR)
        .setContentTitle(content.title)
        .setContentText(content.text)
        .setSubText(content.subText)
        .setOngoing(true)
        .setOnlyAlertOnce(true)
        .setCategory(Notification.CATEGORY_PROGRESS)
        .setVisibility(Notification.VISIBILITY_PUBLIC)
        .setShowWhen(true)
        .setWhen(content.chronometerTarget)
        .setUsesChronometer(true)
        .setChronometerCountDown(true)
        .setTimeoutAfter(content.timeoutMs)
        .setContentIntent(content.openIntent)
        .setStyle(style)
        .addAction(
            Notification.Action.Builder(
                Icon.createWithResource(context, R.drawable.belgrano_ic_stop),
                content.stopLabel,
                content.stopIntent
            ).build()
        )
        .addAction(
            Notification.Action.Builder(
                Icon.createWithResource(context, R.drawable.belgrano_ic_open),
                content.openLabel,
                content.openIntent
            ).build()
        )

    // Ask SystemUI to promote it to a Live Update (status bar chip). Not colorized, ongoing,
    // titled and ProgressStyle, as promotion requires; the OEM/user can still decline it.
    builder.addExtras(Bundle().apply { putBoolean(EXTRA_REQUEST_PROMOTED_ONGOING, true) })
    invokeOptional(builder, "setRequestPromotedOngoing", java.lang.Boolean.TYPE, true)

    content.shortText?.let { invokeOptional(builder, "setShortCriticalText", String::class.java, it) }

    return builder.build()
  }

  // Calls a builder method that may not exist on this platform build (resolved at runtime so the
  // module still compiles against SDKs where the method is missing or differently named).
  private fun invokeOptional(target: Any, name: String, type: Class<*>, value: Any) {
    try {
      target.javaClass.getMethod(name, type).invoke(target, value)
    } catch (e: Exception) {
      // Not available: the regular ongoing notification is still shown.
    }
  }
}
