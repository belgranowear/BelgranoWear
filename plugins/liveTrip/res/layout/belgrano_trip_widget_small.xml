<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by plugins/withBelgranoLiveTrip.js. 2×2 "next train" widget (RemoteViews). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/belgrano_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/belgrano_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/belgrano_widget_icon_bg"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/belgrano_ic_train"
            android:tint="@color/belgrano_widget_on_primary" />

        <TextView
            android:id="@+id/belgrano_widget_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/belgrano_widget_header"
            android:textColor="@color/belgrano_widget_on_surface"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/belgrano_widget_route"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/belgrano_widget_preview_route"
        android:textColor="@color/belgrano_widget_on_surface_variant"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/belgrano_widget_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/belgrano_widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:text="@string/belgrano_widget_preview_time"
            android:textColor="@color/belgrano_widget_on_surface"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/belgrano_widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/belgrano_widget_pill_primary"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingTop="3dp"
            android:paddingEnd="12dp"
            android:paddingBottom="3dp"
            android:text="@string/belgrano_widget_preview_countdown"
            android:textColor="@color/belgrano_widget_on_primary_container"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/belgrano_widget_freshness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/belgrano_widget_freshness_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/belgrano_widget_pill_live"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingTop="2dp"
                android:paddingEnd="10dp"
                android:paddingBottom="2dp"
                android:text="@string/belgrano_widget_preview_live"
                android:textColor="@color/belgrano_widget_on_live_container"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/belgrano_widget_freshness_other"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/belgrano_widget_pill_neutral"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingTop="2dp"
                android:paddingEnd="10dp"
                android:paddingBottom="2dp"
                android:textColor="@color/belgrano_widget_on_neutral_container"
                android:textSize="11sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/belgrano_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/belgrano_widget_open_app"
        android:textColor="@color/belgrano_widget_on_surface_variant"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
