<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by plugins/withBelgranoLiveTrip.js. 4×2 "next trains" widget (RemoteViews). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/belgrano_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/belgrano_widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/belgrano_widget_icon_bg"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/belgrano_ic_train"
            android:tint="@color/belgrano_widget_on_primary" />

        <TextView
            android:id="@+id/belgrano_widget_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/belgrano_widget_header"
            android:textColor="@color/belgrano_widget_on_surface_variant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/belgrano_widget_route"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/belgrano_widget_preview_route"
            android:textColor="@color/belgrano_widget_on_surface"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/belgrano_widget_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/belgrano_widget_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:maxLines="1"
                android:text="@string/belgrano_widget_preview_time"
                android:textColor="@color/belgrano_widget_on_surface"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/belgrano_widget_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/belgrano_widget_pill_primary"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="@string/belgrano_widget_preview_countdown"
                android:textColor="@color/belgrano_widget_on_primary_container"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/belgrano_widget_freshness"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/belgrano_widget_freshness_live"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/belgrano_widget_pill_live"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="@string/belgrano_widget_preview_live"
                    android:textColor="@color/belgrano_widget_on_live_container"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/belgrano_widget_freshness_other"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/belgrano_widget_pill_neutral"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/belgrano_widget_on_neutral_container"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/belgrano_widget_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="2dp"
            android:background="@color/belgrano_widget_outline" />

        <LinearLayout
            android:id="@+id/belgrano_widget_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/belgrano_ic_train"
                android:tint="@color/belgrano_widget_primary" />

            <TextView
                android:id="@+id/belgrano_widget_row1_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/belgrano_widget_preview_time_2"
                android:textColor="@color/belgrano_widget_on_surface"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/belgrano_widget_row1_source"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/belgrano_widget_preview_scheduled"
                android:textColor="@color/belgrano_widget_on_surface_variant"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/belgrano_widget_row1_minutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/belgrano_widget_preview_countdown_2"
                android:textColor="@color/belgrano_widget_on_surface_variant"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/belgrano_widget_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/belgrano_ic_train"
                android:tint="@color/belgrano_widget_primary" />

            <TextView
                android:id="@+id/belgrano_widget_row2_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/belgrano_widget_preview_time_3"
                android:textColor="@color/belgrano_widget_on_surface"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/belgrano_widget_row2_source"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/belgrano_widget_preview_scheduled"
                android:textColor="@color/belgrano_widget_on_surface_variant"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/belgrano_widget_row2_minutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/belgrano_widget_preview_countdown_3"
                android:textColor="@color/belgrano_widget_on_surface_variant"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/belgrano_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/belgrano_widget_open_app"
        android:textColor="@color/belgrano_widget_on_surface_variant"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
